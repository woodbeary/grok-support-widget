# Copy to apps/chatbot/.env.local

# Server-side xAI key from https://console.x.ai (never exposed to the browser)
XAI_API_KEY=

# Hosts allowed to call /api/chat from a browser, comma-separated (host:port)
ALLOWED_ORIGINS=localhost:3000,localhost:3001

# Enables /admin. There is no default; the dashboard stays locked until this is set.
ADMIN_PASSWORD=

# Optional: key for signing admin session cookies (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
